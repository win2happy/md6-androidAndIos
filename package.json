{
  "name": "md6-app",
  "version": "1.0.0",
  "description": "MD6 Android & iOS App packaged with Capacitor",
  "main": "index.js",
  "scripts": {
    "build": "echo 'No build step needed - using remote URL' && exit 0",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "prepare:android": "npm run cap:add:android && npm run cap:sync",
    "prepare:ios": "npm run cap:add:ios && npm run cap:sync"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "typescript": "^5.4.0"
  },
  "author": "",
  "license": "MIT"
}